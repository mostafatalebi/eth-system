http_bind_addr=0.0.0.0:8080
db_pg_url=postgresql://db_user:db_password@localhost:5432/eth_db
redis_url=redis://127.0.0.1:6379
redis_prefix=eth_app
eth_ws_addr=ws://127.0.0.1:8546
block_upstream_http_addr=https://eth-mainnet.example.invalid/v2/your-api-key
beacon_upstream_http_addr=https://beacon.example.invalid/v2/your-api-key
eth_tx_fetch_rpc_timeout=100ms
enable_http_service=true
start_block_number=1000000
log_level=debug
queue_size=5
block_retrieval_batch_size=1
test_mode_enable=true
test_mode_max_block_fetch_count=10
test_mode_erase_db=false
test_mode_erase_blocks_in_db=false
jwt_secret=dummy-jwt-secret-change-me-in-production
access_token_expiry=15m
refresh_token_expiry=7d
enable_http_signup=true
default_user_username=admin
default_user_password=change-me-please
default_user_roles=admin
