http_bind_addr=0.0.0.0:8080
db_pg_url=postgresql://admin:admin@localhost:5432/eth_db
eth_ws_addr=ws://127.0.0.1:8546
block_upstream_http_addr=
beacon_upstream_http_addr=
eth_tx_fetch_rpc_timeout=100ms
enable_http_service=true
start_block_number=1000000
log_level=debug
queue_size=5
block_retrieval_batch_size=1
test_mode_enable=true
test_mode_max_block_fetch_count=10
test_mode_erase_db=false
test_mode_erase_blocks_in_db=false
default_account_jwt=
enable_default_account=true
jwt_secret=dummy-jwt-secret-change-me-in-production
access_token_expiry=15m
refresh_token_expiry=7d
enable_http_signup=true
